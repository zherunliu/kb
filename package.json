{
  "name": "kb",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "format": "prettier -w ./",
    "sdk:build": "tsc -b packages/content-guard packages/vitepress-content-guard",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "pnpm sdk:build && vitepress dev",
    "docs:build": "pnpm sdk:build && vitepress build",
    "docs:preview": "vitepress preview --port 8080",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vitepress": "2.0.0-alpha.12"
  },
  "dependencies": {
    "@kb/vitepress-content-guard": "workspace:*",
    "vue": "^3.5.22"
  },
  "lint-staged": {
    "*": "prettier --experimental-cli --ignore-unknown -w ./"
  }
}
